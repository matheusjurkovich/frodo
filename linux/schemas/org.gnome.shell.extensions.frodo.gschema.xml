<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.frodo" path="/org/gnome/shell/extensions/frodo/">
    <key name="closed-mode" type="s">
      <choices>
        <choice value="minimal"/>
        <choice value="compact"/>
        <choice value="rotating"/>
      </choices>
      <default>'compact'</default>
    </key>
    <key name="closed-items" type="as">
      <default>['claude-session', 'clock', 'date', 'notifications', 'network', 'battery']</default>
    </key>
    <key name="rotate-seconds" type="i">
      <range min="2" max="30"/>
      <default>4</default>
    </key>
    <key name="pill-position" type="s">
      <choices>
        <choice value="center"/>
        <choice value="left"/>
        <choice value="right"/>
        <choice value="middle-left"/>
        <choice value="middle-right"/>
        <choice value="bottom-left"/>
        <choice value="bottom-center"/>
        <choice value="bottom-right"/>
      </choices>
      <default>'center'</default>
    </key>
    <key name="monitors" type="s">
      <choices>
        <choice value="primary"/>
        <choice value="secondary"/>
        <choice value="both"/>
      </choices>
      <default>'primary'</default>
    </key>
    <key name="hide-top-bar" type="b">
      <default>false</default>
    </key>
    <key name="surface-style" type="s">
      <choices>
        <choice value="solid"/>
        <choice value="frosted"/>
        <choice value="clear"/>
      </choices>
      <default>'solid'</default>
    </key>
    <key name="claude-poll-minutes" type="i">
      <range min="1" max="60"/>
      <default>5</default>
    </key>
    <key name="claude-show-remaining" type="b">
      <default>false</default>
    </key>
    <key name="claude-profiles" type="s">
      <default>'[]'</default>
    </key>
    <key name="claude-profiles-initialized" type="b">
      <default>false</default>
    </key>
    <key name="claude-shortcut" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;z']</default>
    </key>
    <key name="toggle-shortcut" type="as">
      <default>['&lt;Super&gt;z']</default>
    </key>
    <key name="allow-shortcut" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;y']</default>
    </key>
    <key name="deny-shortcut" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;n']</default>
    </key>
    <key name="open-on-hover" type="b">
      <default>true</default>
    </key>
    <key name="auto-close" type="b">
      <default>false</default>
    </key>
    <key name="always-show-pill" type="b">
      <default>false</default>
    </key>
    <key name="pill-ai-activity" type="s">
      <choices>
        <choice value="always"/>
        <choice value="change"/>
        <choice value="never"/>
      </choices>
      <default>'change'</default>
    </key>
    <key name="notify-done" type="b">
      <default>true</default>
    </key>
    <key name="notify-quota" type="b">
      <default>true</default>
    </key>
    <key name="ram-percent" type="b">
      <default>false</default>
    </key>
    <key name="hidden-tabs" type="as">
      <default>[]</default>
    </key>
    <key name="collapsed-cards" type="as">
      <default>[]</default>
    </key>
    <key name="disabled-ai" type="as">
      <default>[]</default>
    </key>
    <key name="gemini-daily-limit" type="i">
      <range min="1" max="100000"/>
      <default>1000</default>
    </key>
    <key name="meeting-notice-minutes" type="i">
      <range min="0" max="60"/>
      <default>10</default>
    </key>
    <key name="tab-order" type="as">
      <default>['general', 'calendar', 'workspaces', 'claude', 'notifications', 'performance', 'mixer']</default>
    </key>
    <key name="peek-clock" type="b">
      <default>true</default>
    </key>
    <key name="peek-every-minutes" type="i">
      <range min="1" max="60"/>
      <default>10</default>
    </key>
    <key name="peek-seconds" type="i">
      <range min="1" max="60"/>
      <default>10</default>
    </key>
    <key name="github-enabled" type="b">
      <default>true</default>
    </key>
    <key name="github-auth" type="s">
      <choices>
        <choice value="gh"/>
        <choice value="token"/>
      </choices>
      <default>'gh'</default>
    </key>
    <key name="github-scope" type="s">
      <choices>
        <choice value="mine"/>
        <choice value="list"/>
      </choices>
      <default>'mine'</default>
    </key>
    <key name="github-repos" type="as">
      <default>[]</default>
    </key>
    <key name="github-alerts" type="as">
      <default>['conflict', 'changes', 'ci', 'review']</default>
    </key>
    <key name="github-muted" type="as">
      <default>[]</default>
    </key>
    <key name="github-pill" type="b">
      <default>true</default>
    </key>
    <key name="github-notify" type="b">
      <default>true</default>
    </key>
    <key name="github-badge" type="b">
      <default>true</default>
    </key>
    <key name="github-poll-minutes" type="i">
      <range min="2" max="15"/>
      <default>5</default>
    </key>
  </schema>
</schemalist>
