<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.frodo" path="/org/gnome/shell/extensions/frodo/">
    <key name="closed-mode" type="s">
      <choices>
        <choice value="minimal"/>
        <choice value="compact"/>
        <choice value="rotating"/>
      </choices>
      <default>'compact'</default>
    </key>
    <key name="closed-items" type="as">
      <default>['clock', 'date', 'notifications', 'network', 'battery']</default>
    </key>
    <key name="rotate-seconds" type="i">
      <range min="2" max="30"/>
      <default>4</default>
    </key>
    <key name="pill-position" type="s">
      <choices>
        <choice value="center"/>
        <choice value="left"/>
        <choice value="right"/>
      </choices>
      <default>'center'</default>
    </key>
    <key name="monitors" type="s">
      <choices>
        <choice value="primary"/>
        <choice value="secondary"/>
        <choice value="both"/>
      </choices>
      <default>'primary'</default>
    </key>
    <key name="hide-top-bar" type="b">
      <default>false</default>
    </key>
    <key name="surface-style" type="s">
      <choices>
        <choice value="solid"/>
        <choice value="frosted"/>
        <choice value="clear"/>
      </choices>
      <default>'solid'</default>
    </key>
    <key name="claude-poll-minutes" type="i">
      <range min="1" max="60"/>
      <default>5</default>
    </key>
    <key name="claude-show-remaining" type="b">
      <default>false</default>
    </key>
    <key name="claude-profiles" type="s">
      <default>'[]'</default>
    </key>
    <key name="claude-profiles-initialized" type="b">
      <default>false</default>
    </key>
    <key name="claude-shortcut" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;z']</default>
    </key>
    <key name="toggle-shortcut" type="as">
      <default>['&lt;Super&gt;z']</default>
    </key>
    <key name="open-on-hover" type="b">
      <default>true</default>
    </key>
    <key name="auto-close" type="b">
      <default>false</default>
    </key>
    <key name="hidden-tabs" type="as">
      <default>[]</default>
    </key>
    <key name="collapsed-cards" type="as">
      <default>[]</default>
    </key>
  </schema>
</schemalist>
